{
	"name": "stenchill-easyeda",
	"type": "module",
	"version": "26.8.1",
	"description": "Generate 3D-printable solder paste stencils from your PCB",
	"author": "Thomas COTTARD <https://www.stenchill.com>",
	"license": "MIT",
	"homepage": "https://www.stenchill.com",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts && ts-node ./config/esbuild.iframe.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run compile && ts-node ./build/packaged.ts",
		"debug": "ts-node ./build/dev.ts",
		"update:check": "ts-node ./build/update.ts check",
		"update": "ts-node ./build/update.ts update && npm install",
		"manifest:generate": "npm install && ts-node ./build/manifest.ts generate",
		"manifest:bump": "npm install && ts-node ./build/manifest.ts bump && npm install",
		"test": "tsc --noEmit && vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.4.17",
		"@types/fs-extra": "^11.0.4",
		"@types/ws": "^8.5.13",
		"@vitest/coverage-v8": "^4.1.11",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"happy-dom": "^20.12.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"rimraf": "^6.0.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3",
		"vitest": "^4.1.11",
		"ws": "^8.18.0"
	}
}
